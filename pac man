
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Classic Pac-Man</title>
<style>
* { box-sizing: border-box; }
body {
  margin: 0;
  background: #050510;
  color: white;
  font-family: Arial, sans-serif;
  text-align: center;
}
h1 {
  color: #ffeb00;
  letter-spacing: 5px;
  text-shadow: 0 0 12px #ffeb00;
  margin: 14px 0;
}
#stats {
  display: flex;
  justify-content: center;
  gap: 25px;
  font-size: 16px;
  margin: 10px;
  color: white;
}
#game {
  display: block;
  width: min(94vw, 540px);
  height: auto;
  margin: 0 auto;
  border: 3px solid #203cff;
  border-radius: 5px;
  background: black;
  image-rendering: pixelated;
}
#message {
  min-height: 25px;
  margin: 10px;
  color: #ffeb00;
  font-weight: bold;
}
button {
  background: #ffeb00;
  color: #09091b;
  border: 0;
  border-radius: 8px;
  padding: 11px 18px;
  margin: 5px;
  font-size: 15px;
  font-weight: bold;
  cursor: pointer;
}
button:hover { background: white; }
#controls {
  display: grid;
  grid-template-columns: 55px 55px 55px;
  gap: 5px;
  justify-content: center;
  margin: 12px auto;
}
#controls button {
  margin: 0;
  padding: 12px 0;
  font-size: 21px;
}
.help { color: #aaa; font-size: 12px; }
</style>
</head>
<body>
<h1>PAC-MAN</h1>

<div id="stats">
  <span> SCORE: <b id="score">0</b></span>
  <span> LIVES: <b id="lives">3</b></span>
  <span> LEVEL: <b id="level">1</b></span>
</div>

<canvas id="game" width="420" height="462"></canvas>
<div id="message">Eat all the dots!</div>
<button onclick="startGame()">NEW GAME</button>

<div id="controls">
  <span></span>
  <button onclick="turn(0,-1)">▲</button>
  <span></span>
  <button onclick="turn(-1,0)">◀</button>
  <button onclick="turn(0,1)">▼</button>
  <button onclick="turn(1,0)">▶</button>
</div>
<p class="help">Use the arrow keys or WASD to move.</p>

<script>
const canvas = document.getElementById("game");
const ctx = canvas.getContext("2d");

const TILE = 21;
const COLS = 20;
const ROWS = 22;

// # = wall, . = dot, o = power pellet
const originalMap = [
"####################",
"#o.......##.......o#",
"#.##.###.##.###.##.#",
"#..................#",
"#.##.#.######.#.##.#",
"#....#...##...#....#",
"####.###.##.###.####",
"####.#........#.####",
"####.#.##  ##.#.####",
"#......#  #......  #",
"#.##.#.#  #.#.##.#..#",
"#....#........#....#",
"###.###.####.###.###",
"#...#..........#...#",
"#.#.#.##.##.##.#.#.#",
"#o..#....##....#..o#",
"###.####.##.####.###",
"#..................#",
"#.##.###.##.###.##.#",
"#....#...  ...#....#",
"#.######.##.######.#",
"####################"
];

let map, pac, ghosts, score, lives, level;
let wanted = {x:1,y:0};
let running = false;
let ready = false;
let lastTime = 0;
let moveTimer = 0;
let powerTimer = 0;

function loadMap() {
  map = originalMap.map(row => {
    let fixed = row;
    while (fixed.length < COLS) fixed += "#";
    return fixed.slice(0,COLS).split("");
  });
}

function startGame() {
  score = 0;
  lives = 3;
  level = 1;
  powerTimer = 0;
  loadMap();
  resetPositions();
  running = true;
  ready = true;
  document.getElementById("message").textContent =
    "Eat all the dots and avoid the ghosts!";
  updateStats();
}

function resetPositions() {
  pac = {x:1,y:3,dir:{x:0,y:0}};
  wanted = {x:1,y:0};
  ghosts = [
    {x:9,y:9,color:"#ff3333",dir:{x:1,y:0}},
    {x:10,y:9,color:"#ff80c0",dir:{x:-1,y:0}},
    {x:9,y:11,color:"#00eaff",dir:{x:0,y:-1}},
    {x:10,y:11,color:"#ff9b36",dir:{x:0,y:1}}
  ];
}

function wall(x,y) {
  if (y < 0 || y >= ROWS || x < 0 || x >= COLS)
    return true;
  return map[y][x] === "#";
}

function turn(x,y) {
  wanted = {x,y};
  if (!running) {
    if (!ready) startGame();
  }
}

document.addEventListener("keydown", e => {
  const keys = {
    ArrowUp:[0,-1], w:[0,-1], W:[0,-1],
    ArrowDown:[0,1], s:[0,1], S:[0,1],
    ArrowLeft:[-1,0], a:[-1,0], A:[-1,0],
    ArrowRight:[1,0], d:[1,0], D:[1,0]
  };
  if (keys[e.key]) {
    e.preventDefault();
    turn(...keys[e.key]);
  }
  if (e.key === " " && !running) startGame();
});

function updateStats() {
  document.getElementById("score").textContent = score;
  document.getElementById("lives").textContent = lives;
  document.getElementById("level").textContent = level;
}

function movePac() {
  if (!wall(pac.x+wanted.x,pac.y+wanted.y)) {
    pac.dir = {...wanted};
  }
  const nx = pac.x + pac.dir.x;
  const ny = pac.y + pac.dir.y;
  if (!wall(nx,ny)) {
    pac.x = nx;
    pac.y = ny;
  }

  const tile = map[pac.y][pac.x];
  if (tile === ".") {
    score += 10;
    map[pac.y][pac.x] = " ";
  } else if (tile === "o") {
    score += 50;
    map[pac.y][pac.x] = " ";
    powerTimer = 7;
  }

  if (score > 0 && map.every(row =>
      row.every(cell => cell !== "." && cell !== "o"))) {
    level++;
    loadMap();
    resetPositions();
    powerTimer = 0;
    document.getElementById("message").textContent =
      "Level " + level + "! Keep going!";
  }
  updateStats();
}

function moveGhosts() {
  ghosts.forEach(g => {
    const options = [
      {x:1,y:0},{x:-1,y:0},
      {x:0,y:1},{x:0,y:-1}
    ].filter(d => !wall(g.x+d.x,g.y+d.y));

    const reverse = {x:-g.dir.x,y:-g.dir.y};
    const nonReverse = options.filter(d =>
      !(d.x===reverse.x && d.y===reverse.y));
    const choices = nonReverse.length ? nonReverse : options;

    if (Math.random() < 0.5 || wall(g.x+g.dir.x,g.y+g.dir.y)) {
      if (powerTimer > 0) {
        choices.sort((a,b) => {
          const da = Math.abs(g.x+a.x-pac.x)+
                     Math.abs(g.y+a.y-pac.y);
          const db = Math.abs(g.x+b.x-pac.x)+
                     Math.abs(g.y+b.y-pac.y);
          return db-da;
        });
        g.dir = choices[0] || g.dir;
      } else if (Math.random() < 0.5) {
        choices.sort((a,b) => {
          const da = Math.abs(g.x+a.x-pac.x)+
                     Math.abs(g.y+a.y-pac.y);
          const db = Math.abs(g.x+b.x-pac.x)+
                     Math.abs(g.y+b.y-pac.y);
          return da-db;
        });
        g.dir = Math.random() < 0.7 ? choices[0] :
          choices[Math.floor(Math.random()*choices.length)];
      } else {
        g.dir = choices[Math.floor(Math.random()*choices.length)] || g.dir;
      }
    }

    const nx = g.x + g.dir.x;
    const ny = g.y + g.dir.y;
    if (!wall(nx,ny)) {
      g.x = nx;
      g.y = ny;
    }
  });
}

function checkCollisions() {
  for (let i=0; i<ghosts.length; i++) {
    const g = ghosts[i];
    if (g.x === pac.x && g.y === pac.y) {
      if (powerTimer > 0) {
        score += 200;
        g.x = 9;
        g.y = 9;
      } else {
        lives--;
        updateStats();
        if (lives <= 0) {
          running = false;
          document.getElementById("message").textContent =
            "GAME OVER! Score: " + score;
        } else {
          document.getElementById("message").textContent =
            "Watch out! " + lives + " lives left!";
          resetPositions();
        }
      }
      break;
    }
  }
}

function drawPac() {
  const cx = (pac.x+0.5)*TILE;
  const cy = (pac.y+0.5)*TILE;
  const angle = Math.atan2(pac.dir.y,pac.dir.x);
  const mouth = running ? 0.24+0.13*Math.sin(Date.now()/65) : 0.3;
  ctx.fillStyle = "#ffeb00";
  ctx.beginPath();
  ctx.moveTo(cx,cy);
  ctx.arc(cx,cy,TILE*0.43,angle+mouth,angle+Math.PI*2-mouth);
  ctx.closePath();
  ctx.fill();
}

function drawGhost(g) {
  const x = g.x*TILE;
  const y = g.y*TILE;
  const frightened = powerTimer > 0;
  ctx.fillStyle = frightened ? "#234aff" : g.color;
  ctx.beginPath();
  ctx.arc(x+TILE/2,y+TILE/2-1,TILE*0.42,Math.PI,0);
  ctx.lineTo(x+TILE*0.92,y+TILE*0.9);
  ctx.lineTo(x+TILE*0.72,y+TILE*0.78);
  ctx.lineTo(x+TILE*0.5,y+TILE*0.9);
  ctx.lineTo(x+TILE*0.28,y+TILE*0.78);
  ctx.lineTo(x+TILE*0.08,y+TILE*0.9);
  ctx.closePath();
  ctx.fill();

  if (!frightened) {
    ctx.fillStyle = "white";
    ctx.beginPath();
    ctx.ellipse(x+TILE*0.35,y+TILE*0.43,3.1,4.2,0,0,Math.PI*2);
    ctx.ellipse(x+TILE*0.67,y+TILE*0.43,3.1,4.2,0,0,Math.PI*2);
    ctx.fill();
    ctx.fillStyle = "#1111bb";
    ctx.beginPath();
    ctx.arc(x+TILE*0.36,y+TILE*0.45,1.6,0,Math.PI*2);
    ctx.arc(x+TILE*0.68,y+TILE*0.45,1.6,0,Math.PI*2);
    ctx.fill();
  } else {
    ctx.fillStyle = "white";
    ctx.fillRect(x+4,y+9,4,3);
    ctx.fillRect(x+13,y+9,4,3);
  }
}

function draw() {
  ctx.fillStyle = "black";
  ctx.fillRect(0,0,canvas.width,canvas.height);

  for (let y=0;y<ROWS;y++) {
    for (let x=0;x<COLS;x++) {
      const cell = map[y][x];
      const px=x*TILE, py=y*TILE;
      if (cell === "#") {
        ctx.fillStyle="#07105c";
        ctx.fillRect(px,py,TILE,TILE);
        ctx.strokeStyle="#315cff";
        ctx.lineWidth=1.4;
        ctx.strokeRect(px+1.5,py+1.5,TILE-3,TILE-3);
      } else if (cell === ".") {
        ctx.fillStyle="#ffe5b4";
        ctx.beginPath();
        ctx.arc(px+TILE/2,py+TILE/2,2.1,0,Math.PI*2);
        ctx.fill();
      } else if (cell === "o") {
        ctx.fillStyle="#fff2b5";
        ctx.beginPath();
        ctx.arc(px+TILE/2,py+TILE/2,5+Math.sin(Date.now()/100)*1.2,0,Math.PI*2);
        ctx.fill();
      }
    }
  }

  ghosts.forEach(drawGhost);
  drawPac();
}

function loop(time) {
  const dt = Math.min((time-lastTime)/1000,0.1);
  lastTime = time;

  if (running) {
    moveTimer += dt;
    if (powerTimer > 0) powerTimer -= dt;

    if (moveTimer > 0.13) {
      movePac();
      if (running) moveGhosts();
      if (running) checkCollisions();
      moveTimer = 0;
    }
  }

  draw();
  requestAnimationFrame(loop);
}

startGame();
requestAnimationFrame(loop);
</script>
</body>
</html>
